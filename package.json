{
  "name": "ecom",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "type": "module",
  "scripts": {
    "dev:client": "pnpm --filter client dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:product": "pnpm --filter product-service dev",
    "dev:order": "pnpm --filter order-service dev",
    "dev:payment": "pnpm --filter payment-service dev",
    "dev:auth": "pnpm --filter auth-service dev",
    "dev:mail": "pnpm --filter email-service dev",
    "dev:types": "pnpm --filter @packages/types dev",
    "dev:kafka": "pnpm --filter @packages/kafka dev",
    "dev:logger": "pnpm --filter @packages/logger dev",
    "dev:packages": "pnpm --parallel --filter @packages/types --filter @packages/kafka --filter @packages/logger dev",
    "dev:services": "pnpm --parallel dev:product dev:order dev:payment dev:auth dev:mail",
    "dev:web": "pnpm --parallel dev:client dev:admin",
    "dev:prim": "pnpm --parallel --filter auth-service --filter product-service --filter order-service --filter payment-service dev",
    "dev:all": "pnpm --parallel dev:packages dev:services dev:web",
    "build:packages": "pnpm --parallel --filter @packages/types --filter @packages/kafka --filter @packages/logger --filter @packages/db build",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "pnpm -r start",
    "clean": "pnpm -r clean",
    "dev:infra": "docker compose up kafka postgres",
    "deploy:services": "pnpm build && pnpm -r start",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "@types/node": "^26.1.1",
    "typescript": "^6",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
